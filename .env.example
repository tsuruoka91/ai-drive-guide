# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=ai_drive_guide_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-development
RAILS_MAX_THREADS=5

# Keep this value only in .env or the deployment environment. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Browser-facing key for Maps JavaScript API. Restrict it to HTTP referrers and this API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Identify this application when using the public OpenStreetMap Nominatim service.
NOMINATIM_USER_AGENT=ai-drive-guide/0.1
OVERPASS_USER_AGENT=ai-drive-guide/0.1
WIKIPEDIA_USER_AGENT=ai-drive-guide/0.1
